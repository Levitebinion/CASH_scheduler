#include <QApplication>
#include <QWidget>
#include <QVBoxLayout>
#include <QHBoxLayout>
#include <QGridLayout>
#include <QPushButton>
#include <QLabel>
#include <QStringList>
#include <QDate>
#include <QCoreApplication>
#include <QFile>
#include <QTextStream>
#include <QDebug>
#include <QDialog>
#include <QLineEdit>
#include <QFormLayout>
#include <QDialogButtonBox>
#include <QMessageBox>

#include "calendar.h"
#include <chrono>

QDate currentDisplayDate = QDate::currentDate();

void updateCalendarGrid(
    QGridLayout *grid,
    QLabel *monthLabel,
    QLabel *selectedLabel,
    QWidget *window,
    Calendar *calendar
) {
    monthLabel->setText(
        currentDisplayDate.toString("MMMM yyyy")
    );

    QLayoutItem *child;

    while ((child = grid->takeAt(0)) != nullptr) {
        if (child->widget()) {
            delete child->widget();
        }
        delete child;
    }

    QDate firstOfMonth(
        currentDisplayDate.year(),
        currentDisplayDate.month(),
        1
    );

    int startCol = firstOfMonth.dayOfWeek() - 1;
    int daysInMonth = currentDisplayDate.daysInMonth();

    int dayNumber = 1;
    int row = 0;

    for (int col = startCol; dayNumber <= daysInMonth; ++col) {
        if (col == 7) {
            col = 0;
            row++;
        }

        QPushButton *dayBtn =
            new QPushButton(QString::number(dayNumber));

        dayBtn->setMinimumSize(40, 40);

        int clickedDay = dayNumber;

        QObject::connect(
            dayBtn,
            &QPushButton::clicked,
            [clickedDay, selectedLabel, window, calendar]() {

                QDate clickedDate(
                    currentDisplayDate.year(),
                    currentDisplayDate.month(),
                    clickedDay
                );

                selectedLabel->setText(
                    "Selected Date: " +
                    clickedDate.toString("yyyy-MM-dd")
                );

                QDialog dialog(window);

                dialog.setWindowTitle("Add Event");
                dialog.resize(300, 200);

                QVBoxLayout *dialogLayout =
                    new QVBoxLayout(&dialog);

                QLabel *dateHeader = new QLabel(
                    "Add event for: " +
                    clickedDate.toString("yyyy-MM-dd")
                );

                QLineEdit *idInput =
                    new QLineEdit(&dialog);

                idInput->setPlaceholderText(
                    "Enter Event ID (integer)..."
                );

                QLineEdit *titleInput =
                    new QLineEdit(&dialog);

                titleInput->setPlaceholderText(
                    "Enter Event Title..."
                );

                QDialogButtonBox *buttonBox =
                    new QDialogButtonBox(
                        QDialogButtonBox::Save |
                        QDialogButtonBox::Cancel,
                        &dialog
                    );

                dialogLayout->addWidget(dateHeader);
                dialogLayout->addWidget(idInput);
                dialogLayout->addWidget(titleInput);
                dialogLayout->addWidget(buttonBox);

                QObject::connect(
                    buttonBox,
                    &QDialogButtonBox::accepted,
                    &dialog,
                    &QDialog::accept
                );

                QObject::connect(
                    buttonBox,
                    &QDialogButtonBox::rejected,
                    &dialog,
                    &QDialog::reject
                );

                if (dialog.exec() == QDialog::Accepted) {

                    bool ok;

                    int eventId =
                        idInput->text().toInt(&ok);

                    QString eventTitle =
                        titleInput->text();

                    if (!ok) {
                        QMessageBox::warning(
                            window,
                            "Invalid Event ID",
                            "Please enter a valid integer Event ID."
                        );
                        return;
                    }

                    if (eventTitle.trimmed().isEmpty()) {
                        QMessageBox::warning(
                            window,
                            "Invalid Event Title",
                            "Please enter an event title."
                        );
                        return;
                    }

                    const auto eventDate =
                        std::chrono::year_month_day{
                            std::chrono::year{
                                clickedDate.year()
                            },
                            std::chrono::month{
                                static_cast<unsigned>(
                                    clickedDate.month()
                                )
                            },
                            std::chrono::day{
                                static_cast<unsigned>(
                                    clickedDate.day()
                                )
                            }
                        };

                    const auto eventTime =
                        std::chrono::system_clock::time_point{
                            std::chrono::duration_cast<
                                std::chrono::system_clock::duration
                            >(
                                std::chrono::sys_days{
                                    eventDate
                                }.time_since_epoch()
                            )
                        };

                    CalendarEvent newEvent(
                        eventId,
                        eventTitle.toStdString(),
                        "",
                        eventTime,
                        std::chrono::minutes{0},
                        std::chrono::minutes{0}
                    );

                    bool success =
                        calendar->addEvent(newEvent);

                    if (success) {
                        QMessageBox::information(
                            window,
                            "Event Added",
                            "Event successfully added!"
                        );

                        qDebug()
                            << "Event successfully added to backend!";
                    } else {
                        QMessageBox::warning(
                            window,
                            "Duplicate Event ID",
                            "An event with that ID already exists."
                        );
                    }
                }
            }
        );

        grid->addWidget(dayBtn, row, col);
        dayNumber++;
    }
}

int main(int argc, char *argv[]) {

    QApplication app(argc, argv);

    QString stylePath =
        QCoreApplication::applicationDirPath()
        + "/../styles.qss";

    QFile file(stylePath);

    bool styleOpened =
        file.open(QFile::ReadOnly | QFile::Text);

    if (!styleOpened) {
        file.setFileName("styles.qss");

        styleOpened =
            file.open(QFile::ReadOnly | QFile::Text);

        if (!styleOpened) {
            qWarning()
                << "Could not open styles.qss!";
        }
    }

    if (file.isOpen()) {
        QTextStream stream(&file);
        app.setStyleSheet(stream.readAll());
        file.close();
    }

    QWidget window;
    Calendar calendar;

    window.setWindowTitle("CASH Scheduler");
    window.resize(600, 500);

    QVBoxLayout *mainLayout =
        new QVBoxLayout(&window);

    QHBoxLayout *headerLayout =
        new QHBoxLayout();

    QPushButton *prevBtn =
        new QPushButton("<");

    QLabel *monthLabel =
        new QLabel();

    QPushButton *nextBtn =
        new QPushButton(">");

    headerLayout->addWidget(prevBtn);
    headerLayout->addStretch();
    headerLayout->addWidget(monthLabel);
    headerLayout->addStretch();
    headerLayout->addWidget(nextBtn);

    mainLayout->addLayout(headerLayout);

    QGridLayout *daysHeaderLayout =
        new QGridLayout();

    QStringList days = {
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
    };

    for (int col = 0; col < 7; ++col) {
        QLabel *dayLabel =
            new QLabel(days[col]);

        dayLabel->setAlignment(Qt::AlignCenter);

        daysHeaderLayout->addWidget(
            dayLabel,
            0,
            col
        );
    }

    mainLayout->addLayout(daysHeaderLayout);

    QGridLayout *calendarGrid =
        new QGridLayout();

    mainLayout->addLayout(calendarGrid);

    QLabel *selectedDateLabel =
        new QLabel("Selected Date: None");

    selectedDateLabel->setAlignment(
        Qt::AlignCenter
    );

    mainLayout->addWidget(selectedDateLabel);

    QPushButton *searchBtn =
        new QPushButton("Search Event");

    searchBtn->setMinimumHeight(40);

    mainLayout->addWidget(searchBtn);

    QObject::connect(
        searchBtn,
        &QPushButton::clicked,
        [&]() {

            QDialog dialog(&window);

            dialog.setWindowTitle("Search Event");
            dialog.resize(350, 150);

            QVBoxLayout *dialogLayout =
                new QVBoxLayout(&dialog);

            QLabel *idLabel =
                new QLabel("Enter Event ID:");

            QLineEdit *idInput =
                new QLineEdit(&dialog);

            idInput->setPlaceholderText(
                "Enter Event ID..."
            );

            QDialogButtonBox *buttonBox =
                new QDialogButtonBox(
                    QDialogButtonBox::Ok |
                    QDialogButtonBox::Cancel,
                    &dialog
                );

            dialogLayout->addWidget(idLabel);
            dialogLayout->addWidget(idInput);
            dialogLayout->addWidget(buttonBox);

            QObject::connect(
                buttonBox,
                &QDialogButtonBox::accepted,
                &dialog,
                &QDialog::accept
            );

            QObject::connect(
                buttonBox,
                &QDialogButtonBox::rejected,
                &dialog,
                &QDialog::reject
            );

            if (dialog.exec() == QDialog::Accepted) {

                bool ok;

                int eventID =
                    idInput->text().toInt(&ok);

                if (!ok) {
                    QMessageBox::warning(
                        &window,
                        "Invalid Input",
                        "Please enter a valid Event ID."
                    );
                    return;
                }

                CalendarEvent *event =
                    calendar.getEvent(eventID);

                if (event == nullptr) {
                    QMessageBox::warning(
                        &window,
                        "Event Not Found",
                        "No event exists with that ID."
                    );
                    return;
                }

                QString eventInfo =
                    "Event ID: " +
                    QString::number(
                        event->getEventID()
                    ) +
                    "\n\nTitle: " +
                    QString::fromStdString(
                        event->getDescription()
                    ) +
                    "\n\nLocation: " +
                    QString::fromStdString(
                        event->getLocation()
                    ) +
                    "\n\nGet Ready: " +
                    QString::number(
                        event->getReadyOff().count()
                    ) +
                    " minutes before event" +
                    "\n\nLeave: " +
                    QString::number(
                        event->getLeaveOffset().count()
                    ) +
                    " minutes before event";

                QMessageBox::information(
                    &window,
                    "Event Found",
                    eventInfo
                );

                qDebug()
                    << "Event found:"
                    << eventID;
            }
        }
    );

    QObject::connect(
        nextBtn,
        &QPushButton::clicked,
        [&]() {

            currentDisplayDate =
                currentDisplayDate.addMonths(1);

            updateCalendarGrid(
                calendarGrid,
                monthLabel,
                selectedDateLabel,
                &window,
                &calendar
            );
        }
    );

    QObject::connect(
        prevBtn,
        &QPushButton::clicked,
        [&]() {

            currentDisplayDate =
                currentDisplayDate.addMonths(-1);

            updateCalendarGrid(
                calendarGrid,
                monthLabel,
                selectedDateLabel,
                &window,
                &calendar
            );
        }
    );

    updateCalendarGrid(
        calendarGrid,
        monthLabel,
        selectedDateLabel,
        &window,
        &calendar
    );

    window.show();

    return app.exec();
}
